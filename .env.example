# Salin menjadi .env lalu GANTI nilai rahasia sebelum dipakai di luar demo.
APP_ENV=development
# Kunci pseudonimisasi HMAC-SHA-256 untuk NIK & ID dokter (UU PDP). Jangan commit file .env.
HMAC_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
TOKEN_SECRET=ganti-dengan-string-acak-lain
# Allow the deployed frontend origin; comma-separated for multiple environments.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://app.pharmatrace.my.id
# Parameter engine (usulan awal, dikalibrasi bersama BPJS Kesehatan pada tahap pilot)
GRACE_PERIOD_DAYS=14
AUDIT_SAMPLE_PCT=5
HEATMAP_THRESHOLD_PCT=20
DI_THRESHOLD=20
